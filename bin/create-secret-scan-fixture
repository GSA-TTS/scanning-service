#!/usr/bin/env bash
# Create isolated history for the composite action's full-scan self-test.
set -euo pipefail

if [ "$#" -ne 2 ] || [[ "$2" != clean && "$2" != finding ]]; then
  echo "usage: $0 NEW_DIRECTORY clean|finding" >&2
  exit 2
fi

destination="$1"
kind="$2"
if [ -e "$destination/.git" ] || [ -e "$destination/fixture.txt" ]; then
  echo "Refusing to overwrite an existing fixture or Git repository" >&2
  exit 2
fi

mkdir -p "$destination"
git -C "$destination" init --quiet --initial-branch=main
git -C "$destination" config user.name "Secret Scan Fixture"
git -C "$destination" config user.email "fixture@example.invalid"
printf 'A clean fixture repository.\n' > "$destination/fixture.txt"
git -C "$destination" add fixture.txt
git -C "$destination" commit --quiet -m "Create clean fixture"

if [ "$kind" = finding ]; then
  # Deliberately fake CF password; assembled at runtime, never a credential.
  printf 'CF_%s=%s\n' PASSWORD 'SyntheticFixtureCredential918273645' > "$destination/planted.env"
  git -C "$destination" add planted.env
  git -C "$destination" commit --quiet -m "Plant synthetic secret"
  git -C "$destination" rm --quiet planted.env
  git -C "$destination" commit --quiet -m "Remove synthetic secret from working tree"
fi
