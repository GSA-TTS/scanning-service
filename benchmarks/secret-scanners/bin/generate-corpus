#!/usr/bin/env bash
# Usage: bin/generate-corpus [--out DIR]
#
# Generates a synthetic secret-scanning testing corpus used to score scanners.
#
# REDACTION NOTE
#   Every "secret" below is randomly generated and fake — it authenticates to
#   nothing. The generated corpus is written to a .gitignore'd directory so the
#   specific values never enter version control. Ground truth is encoded purely
#   in the filename prefix, so no file in this repo has to store a literal
#   secret:
#     pos_*  -> file DOES contain a planted secret (scanner SHOULD flag it)
#     neg_*  -> benign look-alike / known false positive (scanner should NOT)
#
# The negative set mirrors the real false-positive fixtures in
# bin/test-gitleaks-config so we measure precision, not just recall.

set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${CORPUS_DIR:-$HERE/.corpus}"

while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

rand() { LC_ALL=C tr -dc "$1" < /dev/urandom | head -c "$2"; }

rm -rf "$OUT"
mkdir -p "$OUT"

# ── positives: one planted secret per file, varied provider formats ──────────

printf 'aws_access_key_id = AKIA%s\naws_secret_access_key = %s\n' \
  "$(rand 'A-Z0-9' 16)" "$(rand 'A-Za-z0-9+/' 40)" > "$OUT/pos_aws.txt"

printf 'GITHUB_TOKEN=ghp_%s\n' "$(rand 'A-Za-z0-9' 36)" > "$OUT/pos_github_pat.env"

printf 'github_fg = github_pat_%s_%s\n' \
  "$(rand 'A-Za-z0-9' 22)" "$(rand 'A-Za-z0-9' 59)" > "$OUT/pos_github_fine.txt"

printf 'SLACK_BOT_TOKEN=xoxb-%s-%s-%s\n' \
  "$(rand '0-9' 12)" "$(rand '0-9' 12)" "$(rand 'A-Za-z0-9' 24)" > "$OUT/pos_slack.env"

printf 'stripe_key = sk_live_%s\n' "$(rand 'A-Za-z0-9' 24)" > "$OUT/pos_stripe.txt"

printf 'SENDGRID=SG.%s.%s\n' \
  "$(rand 'A-Za-z0-9_-' 22)" "$(rand 'A-Za-z0-9_-' 43)" > "$OUT/pos_sendgrid.env"

printf 'npm_token=npm_%s\n' "$(rand 'A-Za-z0-9' 36)" > "$OUT/pos_npm.txt"

printf 'DATABASE_URL=postgres://svc_user:%s@db.internal:5432/app\n' \
  "$(rand 'A-Za-z0-9' 24)" > "$OUT/pos_pg_url.env"

printf 'api_secret = "%s"\n' "$(rand 'A-Za-z0-9' 48)" > "$OUT/pos_generic_hi_entropy.txt"

# JWT (fake header.payload.signature)
printf 'auth = %s.%s.%s\n' \
  "$(printf '{"alg":"HS256","typ":"JWT"}' | base64 | tr -d '=' )" \
  "$(rand 'A-Za-z0-9' 60 | base64 | tr -d '=' )" \
  "$(rand 'A-Za-z0-9_-' 43)" > "$OUT/pos_jwt.txt"

# GCP service account key (fake private_key block)
cat > "$OUT/pos_gcp_sa.json" <<JSON
{
  "type": "service_account",
  "project_id": "demo-benchmark",
  "private_key_id": "$(rand 'a-f0-9' 40)",
  "private_key": "-----BEGIN PRIVATE KEY-----\n$(rand 'A-Za-z0-9+/' 64)\n-----END PRIVATE KEY-----\n",
  "client_email": "svc@demo-benchmark.iam.gserviceaccount.com"
}
JSON

# Real, ephemeral, locally-generated RSA key (never committed; gitignored dir)
if command -v openssl >/dev/null 2>&1; then
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
    -out "$OUT/pos_private_key.pem" 2>/dev/null
else
  # Fallback: header-only PEM (most scanners match on the header)
  printf -- '-----BEGIN PRIVATE KEY-----\n%s\n-----END PRIVATE KEY-----\n' \
    "$(rand 'A-Za-z0-9+/' 200)" > "$OUT/pos_private_key.pem"
fi

# ── negatives: benign look-alikes that must NOT be flagged ───────────────────

cat > "$OUT/neg_placeholders.env" <<'EOF'
CLIENT_SECRET=local-dev-astro-bff-not-a-secret
BACKEND_SECRET=local-dev-spiff-backend-not-a-secret
API_KEY=CHANGEME
EOF

cat > "$OUT/neg_interpolation.sh" <<'EOF'
CF_PASSWORD=${var.cf_password}
DB_HOST=${local.database.hostname}
TOKEN="$(vault read -field=token secret/app)"
EOF

# AWS's own documentation example key — deliberately allowlisted everywhere
cat > "$OUT/neg_example_aws.txt" <<'EOF'
aws_access_key_id = AKIAIOSFODNN7EXAMPLE
aws_secret_access_key = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
EOF

cat > "$OUT/neg_hashes.txt" <<EOF
sha256 = $(rand 'a-f0-9' 64)
commit = $(rand 'a-f0-9' 40)
uuid = $(rand 'a-f0-9' 8)-$(rand 'a-f0-9' 4)-$(rand 'a-f0-9' 4)-$(rand 'a-f0-9' 4)-$(rand 'a-f0-9' 12)
EOF

cat > "$OUT/neg_pem_strip.sh" <<'EOF'
#!/usr/bin/env bash
sed '/-----BEGIN PRIVATE KEY-----/d;/-----END PRIVATE KEY-----/d' "$pemPath"
grep -q '-----BEGIN RSA PRIVATE KEY-----' "$keyfile" && echo "has key"
EOF

cat > "$OUT/neg_vcap_refs.py" <<'EOF'
import os, json, logging
logger = logging.getLogger(__name__)
vcap_services = os.getenv("VCAP_SERVICES")
services = json.loads(vcap_services) if vcap_services else {}
logger.warning("processing VCAP_SERVICES")
EOF

cat > "$OUT/neg_lorem_base64.txt" <<EOF
banner = $(printf 'Lorem ipsum dolor sit amet, welcome to the service.' | base64)
EOF

cat > "$OUT/neg_config_refs.yml" <<'EOF'
database:
  password: ${DB_PASSWORD}
  host: db.internal
oauth:
  client_secret: !ENV OAUTH_CLIENT_SECRET
EOF

pos=$(ls "$OUT" | grep -c '^pos_' || true)
neg=$(ls "$OUT" | grep -c '^neg_' || true)
echo "Corpus generated at: $OUT"
echo "  positives (should be detected): $pos"
echo "  negatives (should be ignored):  $neg"
echo "  values are synthetic + redacted from git (dir is .gitignore'd)"
